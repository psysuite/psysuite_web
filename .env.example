# PsySuite Web Manager Environment Configuration
# Copy this file to .env and update the values for your environment

# Flask Configuration
FLASK_CONFIG=production
SECRET_KEY=change-this-to-a-very-secure-random-string-in-production

# Database Configuration
# For PostgreSQL (recommended for production):
DATABASE_URL=postgresql://psysuite:your_password@localhost:5432/psysuite_web
# For SQLite (development/shared hosting):
# DATABASE_URL=sqlite:///psysuite.db

# Email Configuration (optional, for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Application Settings
ADMIN_EMAIL=alberto.inuggi@gmail.com
ADMIN_PASSWORD=antares

# Security Settings (optional)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
PERMANENT_SESSION_LIFETIME=3600

# Logging (optional)
LOG_LEVEL=INFO
LOG_FILE=logs/app.log